DATABASE_URL=postgresql://postgres:123456@localhost:5432/paper_reader

PDF_EXTRACTOR=pymupdf4llm
CHUNK_MAX_CHARS=2200
ENABLE_DEBUG_EXPORTS=false

MAX_UPLOAD_MB=50
MAX_PAPERS_PER_USER=10
MAX_PROCESSING_PAPERS_PER_USER=1
MAX_FILENAME_LENGTH=255
PDF_UPLOAD_CHUNK_BYTES=1048576
UPLOAD_DIR=/opt/paper_reader/backend/uploads

LOG_LEVEL=INFO
LOG_DIR=/opt/paper_reader/backend/logs

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=2
WORKER_TASK_TIMEOUT_MINUTES=15
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
AUTO_TRANSLATE_AFTER_PARSE=true

INCOMING_FILE_TTL_HOURS=24
ENABLE_ORPHAN_FILE_SCAN=true
AUTO_DELETE_ORPHAN_FILES=false

LLM_API_KEY=replace-with-your-key
LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=

CORS_ORIGINS=https://air.cgu.edu.tw

DEV_USER_OID=dev-user
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=Dev User
DEV_TENANT_ID=dev-tenant

SESSION_SECRET_KEY=change-this-before-deploy
JWT_SECRET_KEY=change-this-before-deploy

